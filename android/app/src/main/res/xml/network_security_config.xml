<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only. cntrd-618y.onrender.com is TLS-terminated by Render;
         no cleartext exceptions needed. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
