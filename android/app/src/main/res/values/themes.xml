<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CNTRD" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:colorPrimary">@color/accent</item>
    </style>

    <!-- Launch theme. The window manager paints this before the process
         is even warm, so the app shows branded cream + the mark instead
         of a white flash. MainActivity swaps back to Theme.CNTRD in
         onCreate() so the splash drawable isn't kept behind the WebView. -->
    <style name="Theme.CNTRD.Splash" parent="Theme.CNTRD">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
